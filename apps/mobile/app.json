{
  "expo": {
    "name": "DeckScores",
    "slug": "deckscores",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "deckscores",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "be.codeink.deckscores",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "be.codeink.deckscores",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/heroimage.jpg",
          "resizeMode": "cover",
          "backgroundColor": "#1E9BD7",
          "dark": {
            "image": "./assets/images/heroimage.jpg",
            "resizeMode": "cover",
            "backgroundColor": "#1E9BD7"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      "@clerk/expo",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bea147f2-4c21-4ade-ae70-7f2881296804"
      }
    },
    "owner": "codeink"
  }
}
